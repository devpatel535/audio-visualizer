<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Declared here so that any app consuming this module inherits it through
      manifest merging. The permission still has to be requested at runtime.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Required to attach to and disable the platform's AGC / noise suppression /
      echo cancellation on the capture session. It is a normal permission,
      granted at install with no prompt. Without it those calls throw and the
      visualizer runs against a stream whose gain the OS is still adjusting.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
