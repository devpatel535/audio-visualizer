<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare, dark, no-action-bar theme. The visualizer paints edge to edge, so
      the window background matches the palette's background to avoid a flash
      during the activity transition.
    -->
    <style name="Theme.AudioViz" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#04070F</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
    </style>
</resources>
